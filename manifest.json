{
  "manifest_version": 3,
  "key": "",
  "name": "WorkWithPriends for WellSky",
  "version": "0.3.0",
  "description": "A dashboard docked inside WellSky: IRF weekly therapy minutes, Section GG documentation review and LTRAX GG sync.",
  "permissions": ["cookies", "storage", "nativeMessaging", "scripting"],
  "host_permissions": ["https://*.specialtycare.wellsky.com/*", "https://ltrax.com/*", "https://*.ltrax.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Show or hide the WorkWithPriends dashboard" },
  "content_scripts": [
    {
      "matches": ["https://*.specialtycare.wellsky.com/*"],
      "js": ["page-bridge.js", "modules/gg/engine.js", "modules/gg/navigator.js", "modules/gg/bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.specialtycare.wellsky.com/*"],
      "js": ["dashboard.js", "modules/minutes.js", "modules/gg/tab.js", "modules/ltrax/tab.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://*.specialtycare.wellsky.com/*"]
    }
  ]
}
